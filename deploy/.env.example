# Copy to deploy/.env. Two values are required; the rest have defaults.
# DAL_IMAGE: a prebuilt image (registry tag or `docker load`ed tarball). Unset = build here.
DAL_IMAGE=
DAL_STORE_USER=change-me
DAL_STORE_PASSWORD=change-me-too
# The producer to pull from: a Phoenix Postgres (Supabase session pooler, port 5432).
# Leave empty to run the store without a sync loop (ingest Claude folders by hand).
PHOENIX_SQL_DATABASE_URL=
PHOENIX_SQL_DATABASE_SCHEMA=phoenix
# name=phoenix-project pairs; each becomes a DAL source and a `source` stamp in the store.
# Leave empty when spans arrive from the capture proxy or from folders. Example: sf-workspaces=sf-workspaces
DAL_SOURCES=
SYNC_INTERVAL=900
SYNC_DAYS=2
# Later pulls re-fetch this many days; the store lands each span once, so overlap is safe.
SYNC_OVERLAP_DAYS=1
ORACLE_INTERVAL=86400
# Lower bound of the daily check, in days back from now. Default: the first pull's start
# date, which is what the store holds. Comparing more than that is a mismatch by construction.
ORACLE_DAYS=
SLACK_WEBHOOK_URL=
# Hook secret for /v1/events/<producer> (GitHub, Forgejo). Unset = unsigned deliveries accepted.
DAL_EVENTS_SECRET=
# Linear API key. Set = the sync loop keeps a `tickets` table in the store (kind, project,
# state per ticket) that a span's `ticket` joins to. Unset = no tickets table.
LINEAR_API_KEY=
# OTLP receiver (Phoenix-free producer path). Source stamp for spans whose resource names
# no project. Bind 0.0.0.0 to accept a producer on another machine.
OTLP_SOURCE_DEFAULT=litellm
DAL_OTLP_BIND=127.0.0.1
DAL_MINIO_BIND=127.0.0.1
DAL_OTLP_PORT=4318
# Rebuild the query layout after each pull (1) or leave it to a manual `dal store verify` (0).
TYPED_REBUILD=1
# DuckDB memory cap for builds and queries, e.g. 8GB. Default: half of RAM. The build spills to disk past it.
DAL_DUCKDB_MEMORY=
# Where the build spills. Put it on the biggest disk; the 16.5M-span build spilled tens of GB.
DAL_DUCKDB_TMP=/data/duckdb-tmp
# 1 = one thread, byte-reproducible files (default). 0 = DAL_BUILD_THREADS cores; ~5x faster past a few million spans.
DAL_BUILD_DETERMINISTIC=1
DAL_BUILD_THREADS=8
# Days per write window. Smaller = flatter memory, more files. 7 held a 16.5M-span build under 60 GB.
DAL_BUILD_CHUNK_DAYS=7
# Capture proxy (compose profile `capture`). Claude Code on any machine sets
# ANTHROPIC_BASE_URL=http://<this host>:4000. Logins pass through; other callers need this key.
LITELLM_MASTER_KEY=change-me-three
# Source stamp on every span the proxy sends.
CAPTURE_SOURCE=claude-code
DAL_LITELLM_BIND=0.0.0.0
DAL_LITELLM_PORT=4000
