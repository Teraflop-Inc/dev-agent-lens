DAL_IMAGE=dal:local
# R2 example: replace account and bucket; credentials never belong in the URI.
DAL_SPAN_STORE=s3://example-dal/spans?endpoint=ACCOUNT.r2.cloudflarestorage.com&region=auto
DAL_RAW_GLOB=s3://example-dal/spans/spans_raw/**/*.parquet
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
# For AWS, use s3://your-bucket/spans and the bucket's AWS region instead.
DAL_EVENTS_SECRET=
DAL_OTLP_PORT=4318
DAL_DUCKDB_MEMORY=2GB
DAL_BUILD_CHUNK_DAYS=1
TYPED_REBUILD=0
